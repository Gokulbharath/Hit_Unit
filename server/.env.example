# HIT UNIT Backend Configuration

# Server Port
# Railway will automatically set this to an available port
# Local development default is 8080
PORT=3001

# Resend Email Service API Key
# Get your API key from https://resend.com
# Sign up for free at https://resend.com/signup
# Required for email sending functionality
RESEND_API_KEY=re_your_resend_api_key_here

# Recipient email address for contact form submissions
# Emails from the contact form will be sent to this address
TO_EMAIL=gokulbharath1221@gmail.com
